<%= form_with(model: post, class: "contents") do |form| %>
  <% if post.errors.any? %>
    <div id="error_explanation" class="bg-matrix-darkgreen bg-opacity-30 text-matrix-lightgreen px-3 py-2 font-medium rounded-lg mt-3">
      <h2><%= pluralize(post.errors.count, "error") %> prohibited this post from being saved:</h2>

      <ul class="list-disc list-inside">
        <% post.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :title, class: "block text-matrix-lightgreen mb-2" %>
    <%= form.text_field :title, class: "w-full p-2 bg-matrix-black text-matrix-green border border-matrix-green rounded focus:outline-none focus:ring-2 focus:ring-matrix-lightgreen" %>
  </div>

  <div class="my-5">
    <%= form.label :content, class: "block text-matrix-lightgreen mb-2" %>
    <%= form.rich_text_area :content, class: "w-full p-2 bg-matrix-black text-matrix-green border border-matrix-green rounded focus:outline-none focus:ring-2 focus:ring-matrix-lightgreen" %>
  </div>

  <div class="inline">
    <%= form.submit class: "bg-matrix-green text-matrix-black px-4 py-2 rounded hover:bg-matrix-lightgreen transition duration-300 cursor-pointer" %>
  </div>
<% end %>
