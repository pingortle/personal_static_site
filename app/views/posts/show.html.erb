<div class="prose prose-invert prose-matrix-green max-w-none">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-matrix-darkgreen bg-opacity-30 mb-5 text-matrix-lightgreen font-medium rounded-lg inline-block" id="notice"><%= notice %></p>
  <% end %>

  <%= render @post %>

  <div class="mt-6 space-x-4">
    <%= link_to "Edit Transmission", edit_post_path(@post), class: "text-matrix-lightgreen hover:underline" %>
    <%= link_to "Return to Transmissions", posts_path, class: "text-matrix-lightgreen hover:underline" %>
    <%= button_to "Erase Transmission", @post, method: :delete, class: "text-matrix-lightgreen hover:underline bg-transparent border-none cursor-pointer", form: { data: { turbo_confirm: 'Are you sure you want to erase this transmission?' } } %>
  </div>
</div>
