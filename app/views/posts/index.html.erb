<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-matrix-darkgreen bg-opacity-50 mb-5 text-matrix-lightgreen font-medium rounded-lg inline-block" id="notice"><%= notice %></p>
  <% end %>

  <% content_for :title, "Posts" %>

  <div class="flex justify-between items-center mb-8">
    <h1 class="font-bold text-4xl text-matrix-lightgreen">Posts</h1>
    <%= link_to "New post", new_post_path, class: "rounded-lg py-2 px-4 bg-matrix-green text-matrix-black font-medium hover:bg-matrix-lightgreen transition duration-300" %>
  </div>

  <div id="posts" class="min-w-full space-y-6">
    <% @posts.each do |post| %>
      <div class="bg-matrix-darkgreen bg-opacity-20 border border-matrix-green rounded-lg p-4">
        <%= render post %>
        <div class="mt-4">
          <%= link_to "Show this post", post, class: "rounded-lg py-2 px-4 bg-matrix-green text-matrix-black font-medium hover:bg-matrix-lightgreen transition duration-300" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
